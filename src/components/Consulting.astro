---
import { site } from '../data/site';
import FormatNote from './FormatNote.astro';
import ItemList from './ItemList.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

const { consulting } = site;
---

<Section id="consulting" labelledby="consulting-title">
  <SectionHeading id="consulting-title" label={consulting.label} title={consulting.title} />

  <div class="grid">
    <p class="intro">{consulting.intro}</p>
    <div class="list">
      <ItemList title={consulting.listTitle} items={consulting.items} />
    </div>
    <div class="format">
      <FormatNote item={consulting.format} />
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-areas: 'intro' 'list' 'format';
  }

  .intro {
    grid-area: intro;
    max-width: 34rem;
    color: var(--ink-2);
    font-size: clamp(1.125rem, 1.8vw, 1.3rem);
    line-height: 1.55;
  }

  .list {
    grid-area: list;
  }

  .format {
    grid-area: format;
    align-self: start;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas:
        'intro list'
        'format list';
      grid-template-rows: auto 1fr;
      column-gap: clamp(3rem, 7vw, 6rem);
      row-gap: 2rem;
    }
  }
</style>
