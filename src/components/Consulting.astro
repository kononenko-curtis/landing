---
import { site } from '../data/site';
import Emphasized from './Emphasized.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

const { consulting } = site;
---

<Section id="consulting" labelledby="consulting-title">
  <SectionHeading id="consulting-title" label={consulting.label} title={consulting.title} />

  <div class="grid">
    <p class="intro">{consulting.intro}</p>

    <div class="list">
      <h3>{consulting.listTitle}</h3>
      <ul>
        {
          consulting.items.map((item) => (
            <li>
              <Emphasized item={item} />
            </li>
          ))
        }
      </ul>
    </div>

    <p class="format"><Emphasized item={consulting.format} /></p>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-areas: 'intro' 'list' 'format';
  }

  .intro {
    grid-area: intro;
    max-width: 34rem;
    color: var(--ink-2);
    font-size: clamp(1.125rem, 1.8vw, 1.3rem);
    line-height: 1.55;
  }

  .list {
    grid-area: list;
  }

  h3 {
    margin-bottom: 0.5rem;
    font: 600 1rem/1.4 var(--font-sans);
    letter-spacing: 0;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding: 1.1rem 0 1.1rem 1.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  li:last-child {
    border-bottom: 1px solid var(--line);
  }

  /* A square rather than a dash: each item already contains " — ". */
  li::before {
    content: '';
    position: absolute;
    top: 1.72rem;
    left: 0.1rem;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--ink);
  }

  .format {
    grid-area: format;
    align-self: start;
    max-width: 34rem;
    padding: 1.35rem 1.5rem;
    background: var(--surface);
    color: var(--ink-2);
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas:
        'intro list'
        'format list';
      grid-template-rows: auto 1fr;
      column-gap: clamp(3rem, 7vw, 6rem);
      row-gap: 2rem;
    }
  }
</style>
