---
interface Props {
  id: string;
  /** light = page grey, white = raised band, dark = inverted band. */
  tone?: 'light' | 'white' | 'dark';
  /** id of the element that names the section, for aria-labelledby. */
  labelledby?: string;
  /** Halve the top padding (the numbers band sits right under the hero). */
  compactTop?: boolean;
}

const { id, tone = 'light', labelledby, compactTop = false } = Astro.props;
---

<section id={id} class:list={['section', tone, { 'compact-top': compactTop }]} aria-labelledby={labelledby}>
  <div class="wrap">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }

  .compact-top {
    padding-top: calc(var(--section-y) / 2);
  }

  .white {
    background: var(--surface);
  }

  .dark {
    background: var(--dark);
    color: var(--on-dark);
  }
</style>
