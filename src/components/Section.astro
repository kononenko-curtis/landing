---
interface Props {
  id: string;
  /** light = page grey, white = raised band, dark = inverted band. */
  tone?: 'light' | 'white' | 'dark';
  /** id of the element that names the section, for aria-labelledby. */
  labelledby?: string;
}

const { id, tone = 'light', labelledby } = Astro.props;
---

<section id={id} class:list={['section', tone]} aria-labelledby={labelledby}>
  <div class="wrap">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
  }

  .white {
    background: var(--surface);
  }

  .dark {
    background: var(--dark);
    color: var(--on-dark);
  }
</style>
