---
import { site } from '../data/site';
---

<footer class="footer">
  <div class="wrap">
    <p>{site.footer}</p>
  </div>
</footer>

<style>
  /* Continues the dark contacts band; the rule marks where the page ends. */
  .footer {
    background: var(--dark);
    color: var(--on-dark-2);
    font-size: 0.875rem;
  }

  .wrap {
    padding-block: 1.75rem;
    border-top: 1px solid var(--dark-line);
  }
</style>
