---
import { site } from '../data/site';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

const { stats } = site;
---

<Section id="stats" tone="dark" labelledby="stats-title" compactTop>
  <SectionHeading id="stats-title" title={stats.title} hidden />
  <ul class="stats">
    {
      stats.items.map((item) => (
        <li>
          <p class="value">{item.value}</p>
          <p class="label">{item.label}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* Equal columns at every width: one, then three, then all five. */
  .stats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    /* Lets the value size itself from the column width (cqi below). */
    container-type: inline-size;
    padding-block: 1.5rem;
    border-top: 1px solid var(--dark-line);
  }

  /* One size for every value, derived from the column width, which is the
     same for all columns. 16.5cqi leaves the longest value ("Сотни млн ₽")
     a little room on one line (it needs ~16.8); nowrap stops it breaking. */
  .value {
    margin-bottom: 0.6rem;
    font-family: var(--font-serif);
    font-size: min(3rem, 16.5cqi);
    line-height: 1.05;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .label {
    color: var(--on-dark-2);
    font-size: 0.975rem;
    line-height: 1.5;
  }

  @media (min-width: 40rem) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .stats {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
