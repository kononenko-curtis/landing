---
import { site } from '../data/site';
---

<header>
  <div class="wrap">
    <p class="role">{site.role}{site.location && <> · {site.location}</>}</p>
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>

    {
      site.links.length > 0 && (
        <nav aria-label="Ссылки">
          <ul>
            {site.links.map((link) => (
              <li>
                <a href={link.href} rel="me noopener">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>

<style>
  header {
    padding-block: clamp(3.5rem, 12vw, 7rem) clamp(2.5rem, 7vw, 4.5rem);
  }

  .role {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.25rem, 8vw, 3.75rem);
  }

  .tagline {
    max-width: 42ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>
