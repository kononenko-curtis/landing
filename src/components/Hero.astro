---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Button from './Button.astro';

const { hero, photos, telegramUrl } = site;

// The two halves of the label are set on their own lines; the "·" stays in
// the markup (for screen readers and copy-paste) and is only hidden visually.
const eyebrowParts = hero.eyebrow.split(' · ');
---

<header class="hero">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">
        {
          eyebrowParts.map((part, i) => (
            <>
              {i > 0 && <span class="visually-hidden"> · </span>}
              <span class="line">{part}</span>
            </>
          ))
        }
      </p>
      <h1>{hero.title}</h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={telegramUrl}>{hero.primaryCta}</Button>
        <Button href={telegramUrl} variant="secondary">{hero.secondaryCta}</Button>
      </div>
    </div>

    <div class="photo">
      <Image
        src={photos.hero}
        alt={site.name}
        widths={[480, 720, 1040]}
        sizes="(min-width: 56rem) 34rem, calc(100vw - 2.5rem)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</header>

<style>
  .hero {
    padding-top: clamp(3rem, 9vw, 6rem);
    overflow: hidden;
  }

  .grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  /* Bottom padding lives on the text only: the photo is cropped at the waist
     and sits flush on the section's lower edge. */
  .copy {
    align-self: center;
  }

  .eyebrow .line {
    display: block;
  }

  .eyebrow .line + .visually-hidden + .line {
    margin-top: 0.2rem;
  }

  h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.9rem, 8.5vw, 5.75rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .lead {
    max-width: 36rem;
    color: var(--ink-2);
    font-size: clamp(1.0625rem, 1.9vw, 1.25rem);
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .photo {
    justify-self: center;
    width: 100%;
    max-width: 34rem;
  }

  .photo :global(img) {
    width: 100%;
  }

  @media (max-width: 30rem) {
    .actions :global(.button) {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: end;
    }

    .copy {
      padding-bottom: clamp(3rem, 8vw, 6rem);
    }

    .photo {
      justify-self: end;
    }
  }
</style>
