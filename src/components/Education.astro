---
import { site } from '../data/site';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

const { education } = site;
---

<Section id="education" labelledby="education-title">
  <div class="grid">
    <div class="head">
      <SectionHeading id="education-title" label={education.label} />
    </div>

    <ul class="entries">
      {
        education.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .grid {
    display: grid;
  }

  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    max-width: 30ch;
    margin-bottom: 0.85rem;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
  }

  p {
    max-width: 42rem;
    color: var(--ink-2);
  }

  /* Same label column as the experience timeline directly above it, and the
     entry indented past the timeline's period column and rail, so its title
     sits under the company names. */
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: var(--label-col) minmax(0, 1fr);
      align-items: start;
    }

    .head {
      padding-top: 0.5rem;
    }

    .entries {
      padding-left: calc(var(--period-col) + var(--rail-indent) + 1px);
    }
  }
</style>
