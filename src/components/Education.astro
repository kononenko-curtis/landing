---
import { site } from '../data/site';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

const { education } = site;
---

<Section id="education" labelledby="education-title">
  <div class="grid">
    <div class="head">
      <SectionHeading id="education-title" label={education.label} />
    </div>

    <div class="groups">
      {
        education.groups.map((group) => (
          <section class="group">
            <h3 class="eyebrow">{group.title}</h3>
            <ul class="entries">
              {group.items.map((item) => (
                <li>
                  <h4>{item.title}</h4>
                  <p>{item.text}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
  }

  .groups {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }

  .entries {
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Institution and year in the serif, description in the grotesk below. */
  h4 {
    max-width: 30ch;
    margin-bottom: 0.6rem;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
  }

  p {
    max-width: 42rem;
    color: var(--ink-2);
  }

  /* Same label column as the experience timeline directly above it, and the
     groups indented past the timeline's period column and rail, so the entry
     titles sit under the company names. The section label and the first group
     label are both small caps and share a top edge. */
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: var(--label-col) minmax(0, 1fr);
      align-items: start;
    }

    .groups {
      padding-left: calc(var(--period-col) + var(--rail-indent) + 1px);
    }
  }
</style>
