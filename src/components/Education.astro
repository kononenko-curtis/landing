---
import { site } from '../data/site';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

const { education } = site;
---

<Section id="education" labelledby="education-title">
  <div class="grid">
    <SectionHeading id="education-title" title={education.title} />

    <ul class="entries">
      {
        education.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .grid {
    display: grid;
  }

  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* No rule above the entry, matching the timeline, so the entry title lines
     up with the section heading beside it. */
  h3 {
    max-width: 30ch;
    padding-top: 0.5rem;
    margin-bottom: 0.85rem;
    font-size: clamp(1.45rem, 2.5vw, 1.9rem);
  }

  p {
    max-width: 42rem;
    color: var(--ink-2);
  }

  /* Same column split as the experience timeline directly above it. */
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
  }
</style>
