---
import { site } from '../data/site';
import Section from './Section.astro';
---

<Section id="projects" title="Проекты">
  <ul class="cards">
    {
      site.projects.map((project) => (
        <li class="card">
          <h3>
            {project.href ? (
              <a href={project.href} rel="noopener">
                {project.name}
              </a>
            ) : (
              project.name
            )}
          </h3>
          <p>{project.description}</p>
          <ul class="stack">
            {project.stack.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    transition: background-color 0.15s ease;
  }

  .card:hover {
    background: var(--panel-hover);
  }

  h3 {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .card > p {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    /* Pins the chips to the bottom so cards of different text lengths align. */
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--muted);
    font-size: 0.78rem;
  }
</style>
